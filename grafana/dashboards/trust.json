  {
   "title": "Trust alerts per minute",
   "type": "timeseries",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "pg"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT $__timeGroupAlias(processed_at, '1m'),\n  count(*) FILTER (WHERE 'near_duplicate' = ANY(flags) OR 'duplicate_image' = ANY(flags)) AS duplicates,\n  count(*) FILTER (WHERE flags && ARRAY['price_anomaly_low','price_anomaly_high']) AS price_anomalies,\n  count(*) FILTER (WHERE 'seller_velocity' = ANY(flags)) AS seller_velocity,\n  count(*) FILTER (WHERE 'shared_phone' = ANY(flags)) AS shared_phone\nFROM risk_events WHERE $__timeFilter(processed_at) GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "id": 10
  },
  {
   "title": "Listings processed per minute by status",
